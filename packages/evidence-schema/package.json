{
  "name": "@security-doctor/evidence-schema",
  "version": "0.1.0",
  "description": "Runtime security-evidence contract emitted by Security Core and consumed by the Verification Engine. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "author": "Security Doctor",
  "homepage": "https://github.com/security-doctor/platform/tree/main/packages/evidence-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/security-doctor/platform.git",
    "directory": "packages/evidence-schema"
  },
  "bugs": {
    "url": "https://github.com/security-doctor/platform/issues"
  },
  "keywords": [
    "security",
    "appsec",
    "evidence",
    "runtime",
    "authorization",
    "schema",
    "json-schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
